<!-- File: res/navigation/nav_graph.xml -->

<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:startDestination="@id/firstFragment">

    <fragment
        android:id="@+id/firstFragment"
        android:name="com.example.examenfinal.ui.fragments.LoginFragment">
        <action
            android:id="@+id/action_firstFragment_to_secondFragment"
            app:destination="@id/secondFragment"/>
    </fragment>

    <fragment
        android:id="@+id/secondFragment"
        android:name="com.example.examenfinal.ui.fragments.SecondFragment">
        <action
            android:id="@+id/action_secondFragment_to_thirdFragment"
            app:destination="@id/thirdFragment"/>
    </fragment>

    <fragment
        android:id="@+id/thirdFragment"
        android:name="com.example.examenfinal.ui.fragments.ThirdFragment"/>
</navigation>
