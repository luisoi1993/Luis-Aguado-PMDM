<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">


    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.trivialfragments.ui.fragment.LoginFragment"
        android:label="LoginFragment" >
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_gameActivity"
            app:destination="@id/gameActivity" />
    </fragment>
    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.trivialfragments.ui.fragment.RegisterFragment"
        android:label="RegisterFragment" />
    <activity
        android:id="@+id/gameActivity"
        android:name="com.example.trivialfragments.ui.activities.GameActivity"
        android:label="activity_game"
        tools:layout="@layout/activity_game" />
</navigation>